# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- System 1 router -------------------------------------------------------
# jev | fallback   (fallback needs no key and no network; CI uses it)
ROUTER_BACKEND=fallback
TYPESAFE_API_KEY=
# Pinned for reproducible evals — do not use jev-latest.
JEV_MODEL=jev-1.13.0

# --- System 2 LLM ----------------------------------------------------------
# ollama | anthropic
LLM_PROVIDER=ollama
# Ollama on the home server, by its Tailscale MagicDNS name (no IP in the repo).
OLLAMA_BASE_URL=http://groot:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# CPU-only inference is slow; keep this generous (seconds).
LLM_TIMEOUT_S=300

# Optional — used only for the final benchmark run.
ANTHROPIC_API_KEY=

# --- Data ------------------------------------------------------------------
DB_PATH=data/benefitpilot.db
